/**
 * @name Omarchy
 * @description Follows the active Omarchy theme, generated by omarchy-theme-set-templates.
 * @author tayters
 * @version 1.0.0
 */

:root,
.theme-dark,
.theme-light,
.theme-darker,
.theme-midnight,
.visual-refresh,
.visual-refresh.theme-dark,
.visual-refresh.theme-light {
  --om-bg: {{ background }};
  --om-surface: {{ mix background foreground 5% }};
  --om-raised: {{ mix background foreground 9% }};
  --om-hover: {{ mix background foreground 12% }};
  --om-line: {{ mix background foreground 16% }};
  --om-fg: {{ foreground }};
  --om-dim: {{ mix foreground background 35% }};
  --om-faint: {{ mix foreground background 55% }};
  --om-accent: {{ accent }};
  --om-accent-soft: {{ mix background accent 25% }};
  --om-link: {{ mix accent foreground 45% }};
  --om-mention: {{ mix background accent 14% }};
  --om-red: {{ red }};
  --om-green: {{ green }};
  --om-yellow: {{ yellow }};

  /* Surfaces */
  --background-base-lowest: var(--om-bg) !important;
  --background-base-lower: var(--om-bg) !important;
  --background-base-low: var(--om-bg) !important;
  --background-primary: var(--om-bg) !important;
  --background-secondary: var(--om-bg) !important;
  --background-secondary-alt: var(--om-surface) !important;
  --background-tertiary: var(--om-bg) !important;
  --background-floating: var(--om-surface) !important;
  --background-nested-floating: var(--om-raised) !important;
  --background-surface-high: var(--om-surface) !important;
  --background-surface-higher: var(--om-surface) !important;
  --background-surface-highest: var(--om-raised) !important;
  --background-mod-subtle: var(--om-surface) !important;
  --background-mod-normal: var(--om-raised) !important;
  --background-mod-strong: var(--om-hover) !important;
  --background-modifier-hover: var(--om-surface) !important;
  --background-modifier-active: var(--om-raised) !important;
  --background-modifier-selected: var(--om-raised) !important;
  --background-modifier-accent: var(--om-line) !important;
  --bg-base-primary: var(--om-bg) !important;
  --bg-base-secondary: var(--om-bg) !important;
  --bg-base-tertiary: var(--om-bg) !important;
  --bg-surface-overlay: var(--om-surface) !important;
  --bg-surface-raised: var(--om-surface) !important;
  --bg-mod-faint: var(--om-surface) !important;
  --bg-mod-subtle: var(--om-raised) !important;
  --bg-mod-strong: var(--om-hover) !important;
  --chat-background-default: var(--om-bg) !important;
  --chat-text-muted: var(--om-dim) !important;
  --input-background: var(--om-surface) !important;
  --input-background-default: var(--om-surface) !important;
  --modal-background: var(--om-bg) !important;
  --modal-footer-background: var(--om-bg) !important;
  --app-frame-background: var(--om-bg) !important;
  --app-border-frame: var(--om-line) !important;
  --home-background: var(--om-bg) !important;
  --channeltextarea-background: var(--om-surface) !important;
  --scrollbar-thin-thumb: var(--om-line) !important;
  --scrollbar-auto-thumb: var(--om-line) !important;
  --scrollbar-auto-track: transparent !important;

  /* Text */
  --text-default: var(--om-fg) !important;
  --text-normal: var(--om-fg) !important;
  --text-strong: var(--om-fg) !important;
  --text-subtle: var(--om-dim) !important;
  --text-muted: var(--om-dim) !important;
  --text-primary: var(--om-fg) !important;
  --text-secondary: var(--om-dim) !important;
  --text-tertiary: var(--om-faint) !important;
  --header-primary: var(--om-fg) !important;
  --header-secondary: var(--om-dim) !important;
  --channels-default: var(--om-dim) !important;
  --channel-icon: var(--om-dim) !important;
  --interactive-normal: var(--om-dim) !important;
  --interactive-hover: var(--om-fg) !important;
  --interactive-active: var(--om-fg) !important;
  --interactive-muted: var(--om-faint) !important;
  --interactive-text-default: var(--om-dim) !important;
  --interactive-text-hover: var(--om-fg) !important;
  --interactive-text-active: var(--om-fg) !important;
  --icon-default: var(--om-dim) !important;
  --icon-subtle: var(--om-faint) !important;
  --text-link: var(--om-link) !important;
  --background-mentioned: var(--om-mention) !important;
  --background-mentioned-hover: var(--om-mention) !important;
  --background-message-highlight: var(--om-mention) !important;
  --background-message-highlight-hover: var(--om-mention) !important;
  --info-warning-foreground: var(--om-accent) !important;
  --info-help-background: var(--om-surface) !important;
  --info-help-foreground: var(--om-accent) !important;
  --info-help-text: var(--om-fg) !important;
  --info-positive-background: var(--om-surface) !important;
  --info-warning-background: var(--om-surface) !important;
  --notice-background-info: var(--om-surface) !important;
  --notice-background-warning: var(--om-surface) !important;
  --text-brand: var(--om-accent) !important;
  --mention-foreground: var(--om-link) !important;
  --mention-background: var(--om-accent-soft) !important;

  /* Borders */
  --border-subtle: var(--om-line) !important;
  --border-normal: var(--om-line) !important;
  --border-strong: var(--om-line) !important;
  --border-faint: var(--om-line) !important;

  /* Accent and status */
  --brand-500: var(--om-accent) !important;
  --brand-560: var(--om-accent) !important;
  --brand-600: var(--om-accent) !important;
  --brand-experiment: var(--om-accent) !important;
  --button-filled-brand-background: var(--om-accent) !important;
  --button-filled-brand-background-hover: var(--om-accent) !important;
  --button-filled-brand-background-active: var(--om-accent) !important;
  --button-filled-brand-text: var(--om-bg) !important;
  --redesign-button-primary-background: var(--om-accent) !important;
  --redesign-button-primary-pressed-background: var(--om-accent) !important;
  --redesign-button-primary-text: var(--om-bg) !important;
  --control-brand-foreground: var(--om-accent) !important;
  --control-brand-foreground-new: var(--om-accent) !important;
  --control-primary-background-default: var(--om-accent) !important;
  --control-primary-background-hover: var(--om-accent) !important;
  --control-primary-background-active: var(--om-accent) !important;
  --control-primary-text-default: var(--om-bg) !important;
  --blurple-50: var(--om-accent) !important;
  --brand-260: var(--om-accent) !important;
  --brand-360: var(--om-accent) !important;
  --brand-400: var(--om-accent) !important;
  --brand-460: var(--om-accent) !important;
  --brand-530: var(--om-accent) !important;
  --status-danger: var(--om-red) !important;
  --status-positive: var(--om-green) !important;
  --status-warning: var(--om-yellow) !important;
  --text-danger: var(--om-red) !important;
  --text-positive: var(--om-green) !important;
  --text-warning: var(--om-yellow) !important;

  --custom-app-top-bar-height: 24px !important;

  /* Font, filled in by the hook so it follows `omarchy font` */
  --font-primary: "__OMARCHY_FONT__", monospace !important;
  --font-display: "__OMARCHY_FONT__", monospace !important;
  --font-headline: "__OMARCHY_FONT__", monospace !important;
  --font-code: "__OMARCHY_FONT__", monospace !important;
}

/* Flat by default, so message rows and lists stay terminal-like. :where keeps
   this easy to override below. Avatars and status dots are masked shapes. */
:where(*:not([class*="avatar"]):not([class*="Avatar"]):not([class*="status"]):not([class*="dot"])) {
  border-radius: 0 !important;
}

/* Corners follow Hyprland's rounding: full on floating surfaces, half on
   small controls. */
:root {
  --om-radius: __OMARCHY_RADIUS__px;
  --om-radius-small: calc(__OMARCHY_RADIUS__px / 2);
}

[class*="menu_"],
[class*="popout"],
[role="dialog"],
[class*="embedFull"],
[class*="embedWrapper"],
[class*="userPopout"],
[class*="biteSize"] {
  border-radius: var(--om-radius) !important;
  overflow: hidden;
}

button,
input,
textarea,
[role="button"],
[role="tab"],
[class*="searchBar"],
[class*="reaction_"],
[class*="botTag"],
[class*="containerDefault"] [class*="link_"],
[class*="interactive"],
[class*="channelTextArea"],
[class*="mention"],
[class*="guilds_"] img,
[class*="childWrapper"],
[class*="imageWrapper"],
[class*="imageContainer"] {
  border-radius: var(--om-radius-small) !important;
}

/* Flat: no shadows or gradients behind panels */
[class*="popout"],
[class*="menu_"],
[class*="modal"],
[class*="layer_"] {
  box-shadow: none !important;
}

[class*="menu_"],
[class*="popout"],
[role="dialog"] {
  border: 1px solid var(--om-line) !important;
}

::selection {
  background: var(--om-accent);
  color: var(--om-bg);
}

::-webkit-scrollbar { width: 6px !important; height: 6px !important; }
::-webkit-scrollbar-thumb { background: var(--om-line) !important; border: 0 !important; }
::-webkit-scrollbar-track { background: transparent !important; border: 0 !important; }

/* Primary buttons. Discord's own colors for these move around, so set the
   element rather than chase its variables. */
button[class*="lookFilled"][class*="colorBrand"],
button[class*="colorBrand"],
button[class*="button_"][type="submit"],
button[data-mana-component="button"][class*="primary" i],
[class*="addFriend" i] {
  background: var(--om-accent) !important;
  color: var(--om-bg) !important;
}

button[class*="colorBrand"] *,
button[class*="button_"][type="submit"] * {
  color: var(--om-bg) !important;
}

/* The mic, headphone and settings buttons are icons, not primary actions */
[class*="panels_"] button,
[class*="panels_"] button[type="submit"],
[class*="panels_"] button[class*="colorBrand"],
[class*="panels_"] button[class*="lookFilled"][class*="colorBrand"],
[class*="panels_"] button[data-mana-component="button"][class*="primary" i] {
  background: transparent !important;
  color: var(--om-fg) !important;
}

[class*="panels_"] button * {
  color: inherit !important;
}

[class*="panels_"] button:hover,
[class*="panels_"] button[class*="colorBrand"]:hover {
  background: var(--om-raised) !important;
}

/* Server icons are clipped by an SVG mask, not border-radius */
nav[aria-label*="Servers" i] foreignObject,
[class*="guilds"] foreignObject {
  mask: none !important;
  -webkit-mask: none !important;
}

/* Top bar: just a thin strip, no web-style navigation */
[aria-label="Back"],
[aria-label="Forward"],
[class*="backForwardButtons"],
[class*="bar_"] > [class*="leading"],
[class*="bar_"] > [class*="title_"] {
  display: none !important;
}

[class*="bar_"] > [class*="trailing"] {
  margin-left: auto !important;
}

/* Messages that mention you */
[class*="mentioned"] {
  background: var(--om-mention) !important;
}

[class*="mentioned"]::before {
  background: var(--om-accent) !important;
}

/* Bot and official tags */
[class*="botTag"] {
  background: var(--om-accent) !important;
  color: var(--om-bg) !important;
}

/* Clutter */
button[aria-label="Send a gift"],
[aria-label="Send a gift"],
a[href="/store"],
a[href="/shop"],
a[href="/quest-home"],
[class*="nitroBadge"],
[class*="nowPlayingColumn"],
[class*="coachmark" i],
[class*="panels_"] > *:has(img):not(:has([class*="avatar" i])):not(:has(button[role="switch"])),
[class*="winButton" i],
[aria-label="Help"] {
  display: none !important;
}

/* Server list: the home icon and selected servers use Discord's blue */
[class*="childWrapper"] {
  background: var(--om-surface) !important;
  color: var(--om-fg) !important;
}

[class*="selected"] [class*="childWrapper"],
[class*="childWrapper"][class*="selected"] {
  background: var(--om-accent) !important;
  color: var(--om-bg) !important;
}

/* >>> tiled layout >>> */
:root,
.visual-refresh,
.visual-refresh.theme-dark,
.visual-refresh.theme-light {
  --om-gap: 8px;
  --om-label: {{ accent }};
  --om-ok: {{ bright_green }};
  --om-name: {{ bright_cyan }};
  --om-section: {{ bright_yellow }};
  --om-pane: {{ background }};
  --chat-background-default: var(--om-pane) !important;
  --background-base-low: var(--om-pane) !important;
  --background-base-lower: var(--om-pane) !important;
  --background-primary: var(--om-pane) !important;
  --background-secondary: var(--om-pane) !important;
}

/* Each region is its own tile, like a window on the desktop */
[class*="guilds_"],
[class*="sidebarList"],
[class*="page_"] {
  border: 1px solid var(--om-line) !important;
  background: var(--om-pane) !important;
  margin: var(--om-gap) 0 var(--om-gap) var(--om-gap) !important;
  box-sizing: border-box !important;
}

[class*="page_"] {
  margin-right: var(--om-gap) !important;
  flex: 1 1 0 !important;
  min-width: 0 !important;
  width: auto !important;
  max-width: calc(100% - var(--om-gap) * 2) !important;
  height: calc(100% - var(--om-gap) * 2) !important;
}

[class*="sidebar_"] {
  border: 0 !important;
  background: transparent !important;
}

[class*="panels_"] {
  background: var(--om-pane) !important;
  border: 1px solid var(--om-line) !important;
  margin: 0 0 var(--om-gap) var(--om-gap) !important;
}

/* Colorful server icons step back until they're wanted */
/* Icons keep their shape but only the theme's colors: a duotone from black to
   the theme's bright green, and to its accent when hovered or selected. */
[class*="guilds_"] foreignObject > *:not([class*="folderButtonInner"]) {
  filter: url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22o%22 color-interpolation-filters=%22sRGB%22%3E%3CfeGaussianBlur in=%22SourceGraphic%22 stdDeviation=%220.45%22 result=%22b%22/%3E%3CfeColorMatrix in=%22b%22 type=%22matrix%22 values=%220.3 0.59 0.11 0 0 0.3 0.59 0.11 0 0 0.3 0.59 0.11 0 0 0 0 0 1 0%22 result=%22g%22/%3E%3CfeComponentTransfer in=%22g%22 result=%22k%22%3E%3CfeFuncR type=%22table%22 tableValues=%220.03 0.5 0.86 1%22/%3E%3CfeFuncG type=%22table%22 tableValues=%220.03 0.5 0.86 1%22/%3E%3CfeFuncB type=%22table%22 tableValues=%220.03 0.5 0.86 1%22/%3E%3C/feComponentTransfer%3E%3CfeFlood flood-color=%22%23{{ bright_green_strip }}%22 result=%22c%22/%3E%3CfeBlend in=%22k%22 in2=%22c%22 mode=%22multiply%22 result=%22t%22/%3E%3CfeComposite in=%22t%22 in2=%22SourceAlpha%22 operator=%22in%22/%3E%3C/filter%3E%3C/svg%3E#o");
  transition: filter 120ms ease;
}

/* One server at a time, never an open folder around others */
[class*="guilds_"] [class*="listItem"]:not(:has([class*="listItem"])):not(:has([class*="folder" i])):hover foreignObject > *,
[class*="guilds_"] [class*="listItem"]:not(:has([class*="listItem"])):not(:has([class*="folder" i])) [class*="selected"] foreignObject > * {
  filter: url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22o%22 color-interpolation-filters=%22sRGB%22%3E%3CfeGaussianBlur in=%22SourceGraphic%22 stdDeviation=%220.45%22 result=%22b%22/%3E%3CfeColorMatrix in=%22b%22 type=%22matrix%22 values=%220.3 0.59 0.11 0 0 0.3 0.59 0.11 0 0 0.3 0.59 0.11 0 0 0 0 0 1 0%22 result=%22g%22/%3E%3CfeComponentTransfer in=%22g%22 result=%22k%22%3E%3CfeFuncR type=%22table%22 tableValues=%220.03 0.5 0.86 1%22/%3E%3CfeFuncG type=%22table%22 tableValues=%220.03 0.5 0.86 1%22/%3E%3CfeFuncB type=%22table%22 tableValues=%220.03 0.5 0.86 1%22/%3E%3C/feComponentTransfer%3E%3CfeFlood flood-color=%22%23{{ accent_strip }}%22 result=%22c%22/%3E%3CfeBlend in=%22k%22 in2=%22c%22 mode=%22multiply%22 result=%22t%22/%3E%3CfeComposite in=%22t%22 in2=%22SourceAlpha%22 operator=%22in%22/%3E%3C/filter%3E%3C/svg%3E#o");
}

/* Less noise */
[class*="clanTag"],
[class*="chipletContainer"] {
  display: none !important;
}

[class*="divider_"] {
  border-color: var(--om-surface) !important;
}

[class*="peopleListItem"] {
  border-color: transparent !important;
}

/* Terminal: small monospace everywhere */
html {
  font-size: 13px !important;
}

[class*="messageContent"],
[class*="markup_"],
[class*="textArea"],
[class*="slateTextArea"],
[class*="embedDescription"],
[class*="embedTitle"],
[class*="username_"],
[class*="repliedTextContent"] {
  font-family: "__OMARCHY_FONT__", monospace !important;
  font-size: 12.5px !important;
  line-height: 1.4 !important;
}

[class*="sidebarList"] *,
[class*="headerContent"],
[class*="title_"] {
  font-size: 12.5px !important;
}

/* IRC-style lines: [18:02] <name> message */
[class*="messageListItem"] [class*="timestamp_"] time::before { content: "["; }
[class*="messageListItem"] [class*="timestamp_"] time::after { content: "]"; }
[class*="messageListItem"] h3 [class*="username_"]::before { content: "<"; color: var(--om-faint); }
[class*="messageListItem"] h3 [class*="username_"]::after { content: ">"; color: var(--om-faint); }

[class*="messageListItem"] [class*="timestamp_"] {
  color: var(--om-faint) !important;
  font-size: 11.5px !important;
  white-space: nowrap !important;
  width: auto !important;
  min-width: 10ch !important;
  text-align: left !important;
}

[class*="messageListItem"] [class*="timestamp_"] time {
  white-space: nowrap !important;
}

:root,
.visual-refresh {
  --custom-message-margin-compact-indent: 11ch !important;
}

[class*="messageListItem"] [class*="avatar_"] {
  display: none !important;
}

/* Replies were sized for Discord's larger text */
[class*="repliedMessage"] {
  height: auto !important;
  min-height: 1.5em !important;
  line-height: 1.5 !important;
  overflow: hidden !important;
  margin-bottom: 1px !important;
}

[class*="repliedMessage"] [class*="hiddenVisually"] {
  display: none !important;
}

[class*="repliedMessage"] > * {
  font-size: 11.5px !important;
  line-height: 1.5 !important;
}

[class*="repliedTextPreview"],
[class*="repliedTextContent"] {
  max-height: none !important;
  overflow: hidden !important;
  padding-bottom: 1px !important;
}

/* Profile panel and popups follow the same small type */
[class*="userPanelInner"] *,
[class*="profilePanel"] *,
[class*="user-profile-sidebar"] *,
[class*="userProfileOuter"] *,
[class*="userPopout"] *,
[class*="biteSize"] *,
[class*="fullSize"] *,
[class*="profile_"] * {
  font-size: 12.5px !important;
  line-height: 1.4 !important;
}

[class*="sidebarList"] [class*="botTag"],
[class*="sidebarList"] [class*="botTag"] * {
  font-size: 10px !important;
  line-height: 1.3 !important;
}

/* Friends page */
[class*="tabBar"] *,
[class*="peopleColumn"] *,
[class*="peopleList"] *,
[class*="peopleListItem"] *,
[class*="searchBar"] *,
[class*="searchBar"] input {
  font-size: 12.5px !important;
}

/* Voice status */
[class*="panels_"] [class*="rtcConnectionStatus"],
[class*="panels_"] [class*="rtcConnectionStatus"] *,
[class*="panels_"] [class*="labelWrapper"] * {
  font-size: 12.5px !important;
}

/* Prompt instead of a message box */
[class*="channelTextArea"] {
  background: transparent !important;
  border-top: 1px solid var(--om-line) !important;
}

[class*="channelTextArea"] [class*="textArea"] {
  position: relative !important;
}

[class*="channelTextArea"] [class*="textArea"]::before {
  content: ">";
  color: var(--om-accent);
  position: absolute;
  left: -12px;
  top: 50%;
  transform: translateY(-50%);
}

/* GIF, sticker, emoji and app buttons; Enter still sends */
[class*="channelTextArea"] [class*="buttons_"] {
  display: none !important;
}

/* Channel lists are text: color stays with unread and mention state */
[class*="sidebarList"] [class*="name_"] {
  filter: grayscale(1);
}

[class*="reaction_"] {
  background: transparent !important;
  border: 1px solid var(--om-line) !important;
}

[class*="embedFull"],
[class*="embedWrapper"] {
  background: transparent !important;
  border: 1px solid var(--om-line) !important;
}

/* AOE-style panes: rounded boxes, a title in the border, one active pane */
[class*="guilds_"],
[class*="sidebarList"],
[class*="page_"],
[class*="panels_"] {
  border-radius: var(--om-radius-small) !important;
  overflow: visible !important;
}

[class*="page_"] {
  border-color: transparent !important;
  position: relative !important;
}

/* The pane's contents paint over a real border's curve, so the visible border
   is an overlay above them. */
[class*="page_"]::before {
  content: "";
  position: absolute;
  inset: -1px;
  z-index: 999;
  border: 1px solid var(--om-label);
  border-radius: var(--om-radius);
  pointer-events: none;
}

[class*="sidebarList"] {
  position: relative !important;
  border-color: transparent !important;
}

[class*="guilds_"] {
  position: relative !important;
  border-color: transparent !important;
}

[class*="sidebarList"]::before,
[class*="guilds_"]::before {
  content: "";
  position: absolute;
  inset: -1px;
  z-index: 999;
  border: 1px solid var(--om-line);
  border-radius: var(--om-radius);
  pointer-events: none;
}

[class*="page_"]::after,
[class*="sidebarList"]::after {
  position: absolute;
  top: -8px;
  left: 12px;
  z-index: 1000;
  padding: 0 5px;
  background: var(--om-bg);
  font-family: "__OMARCHY_FONT__", monospace;
  font-size: 11.5px;
  line-height: 15px;
  pointer-events: none;
}

[class*="page_"]::after {
  content: "chat";
  color: var(--om-label);
}

[class*="sidebarList"]::after {
  content: "channels";
  color: var(--om-section);
}

/* The user panel floats over the bottom of the sidebar, so the panes above it
   stop short and it gets a box of its own. Discord sets the height variable,
   which also covers the taller voice panel. */
[class*="guilds_"],
[class*="sidebarList"] {
  margin-bottom: calc(var(--custom-app-panels-height, 64px) + var(--om-gap) * 2) !important;
  height: auto !important;
}

[class*="panels_"] {
  border-radius: var(--om-radius) !important;
  overflow: hidden !important;
}

/* Discord reserves room in the list for the panel that used to overlap it.
   Only the list's children: the pane itself still needs the real height. */
[class*="sidebarList"] > *,
[class*="sidebarList"] > * * {
  --custom-app-panels-height: 0px !important;
}

[class*="sidebarList"] nav,
[class*="sidebarList"] [class*="scroller"] {
  padding-bottom: 0 !important;
  margin-bottom: 0 !important;
}

/* No server banners */
[class*="sidebarList"] [class*="animatedContainer"],
[class*="sidebarList"] [class*="bannerImage"],
[class*="sidebarList"] [class*="bannerImg"] {
  display: none !important;
}

/* The list still leaves the banner's space at its top */
[class*="sidebarList"]:has([class*="banner" i]) [class*="scroller"] > ul,
[class*="sidebarList"]:has([class*="banner" i]) [class*="scroller"] > div > ul,
[class*="sidebarList"]:has([class*="banner" i]) ul {
  margin-top: -84px !important;
}

/* Server list: closed folders show their folder icon, not 2x2 tiny icons.
   Discord slides between the two, so pin the content and drop the preview. */
[class*="guilds_"] [class*="folderPreviewWrapper"] {
  display: none !important;
}

[class*="guilds_"] [class*="folderButtonContent"] {
  transform: none !important;
}

[class*="guilds_"] [class*="folderIconWrapper"] {
  position: absolute !important;
  inset: 4px !important;
  width: auto !important;
  height: auto !important;
  margin: 0 !important;
  padding: 0 !important;
  box-sizing: border-box !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  opacity: 1 !important;
  transform: none !important;
  background: color-mix(in srgb, var(--om-ok) 16%, transparent) !important;
  border: 0 !important;
  border-radius: var(--om-radius-small) !important;
}

[class*="guilds_"] [class*="folderIconWrapper"] > * {
  display: none !important;
}

[class*="guilds_"] [class*="folderIconWrapper"]::after {
  content: "\f024b"; /* md-folder */
  font-family: "__OMARCHY_FONT__", monospace;
  font-size: 22px;
  line-height: 1;
  color: var(--om-ok);
  transform: translate(-2px, 1px); /* the glyph's own spacing is uneven */
}

[class*="guilds_"] [class*="folderButtonInner"],
[class*="guilds_"] [class*="folderButtonContent"] {
  background: transparent !important;
  position: relative !important;
  width: 100% !important;
  height: 100% !important;
}

[class*="guilds_"] foreignObject > [class*="folderButtonInner"] {
  filter: none !important;
}

/* Unread and selected markers: the rail's small bars, whatever they're called */
[class*="guilds_"] [class*="pill" i] *,
[class*="guilds_"] li > div:first-child > span,
[class*="guilds_"] [class*="listItem"] > div:first-child > span {
  background: var(--om-label) !important;
}

/* Quiet utility buttons */
[class*="guilds_"] [aria-label="Add a Server"],
[class*="guilds_"] [aria-label="Discover"] {
  opacity: 0.5;
}

[class*="guilds_"] [class*="guildSeparator"] {
  background: var(--om-line) !important;
  height: 1px !important;
}

/* Color carries meaning, as it does in a TUI */
[class*="sidebarList"] [aria-expanded] *,
[class*="sidebarList"] [aria-expanded] {
  color: var(--om-section) !important;
  font-weight: 700 !important;
}

[class*="containerDefault"] [class*="selected"],
[class*="containerDefault"][class*="selected"] {
  background: var(--om-raised) !important;
}

[class*="containerDefault"] [class*="selected"] *,
[class*="containerDefault"][class*="selected"] * {
  color: var(--om-ok) !important;
  filter: none !important;
}

[class*="messageListItem"] h3 [class*="username_"] {
  color: var(--om-name) !important;
}

[class*="messageListItem"] [class*="timestamp_"] {
  color: var(--om-section) !important;
}

[class*="headerContent"],
section [class*="title_"] [class*="heading"] {
  color: var(--om-label) !important;
}

[class*="divider_"] [class*="content"] {
  color: var(--om-section) !important;
}

[class*="channelTextArea"] [class*="textArea"]::before {
  color: var(--om-ok) !important;
}

[class*="rtcConnectionStatus"] *,
[class*="panels_"] [class*="labelWrapper"] * {
  color: var(--om-ok) !important;
}

[class*="embedTitle"],
[class*="embedTitle"] * {
  color: var(--om-label) !important;
}
/* <<< tiled layout <<< */
